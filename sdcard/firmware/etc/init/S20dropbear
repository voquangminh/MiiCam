#!/bin/sh
## purpose: Init script for dropbear SSH server
## license: GPLv3+, http://www.gnu.org/licenses/gpl-3.0.html
## author: Jan Sperling , 2017

SD_MOUNTDIR="/tmp/sd"
if [ -r "${SD_MOUNTDIR}/firmware/scripts/functions.sh" ]
then
    . "${SD_MOUNTDIR}/firmware/scripts/functions.sh"
else
    echo "Unable to load basic functions"
    exit 1
fi

NAME="dropbear"
DESC="SSH server"
DAEMON="${SD_MOUNTDIR}/firmware/bin/${NAME}"
PIDFILE="/var/run/${NAME}.pid"
DAEMON_OPTS="-R -p 22 -P ${PIDFILE} $DROPBEAR_EXTRA_ARGS"

check_daemon_bin "${DAEMON}" "${DESC}"

recover_key() {
   if [ -d "${SD_MOUNTDIR}/firmware/etc/dropbear" ]
   then
       printf "*** Copying previous files to /etc/dropbear... "
       cp ${SD_MOUNTDIR}/firmware/etc/dropbear/* /etc/dropbear/
       ok_fail "$?"
   else
       printf "*** Generating a new SSH key for $NAME $DESC... "
       [ -f /etc/dropbear/dropbear_ecdsa_host_key ] && rm /etc/dropbear/dropbear_ecdsa_host_key
       ${SD_MOUNTDIR}/firmware/bin/dropbearkey -f /etc/dropbear/dropbear_ecdsa_host_key -t ecdsa
       ok_fail "$?"
   fi
}


save_key() {
    if [ ! -d "${SD_MOUNTDIR}/firmware/etc/dropbear" ]; then
        mkdir -p "${SD_MOUNTDIR}/firmware/etc/dropbear"
    fi
    SD_HOSTKEYS=$(ls "${SD_MOUNTDIR}/firmware/etc/dropbear/dropbear_"*_host_key 2>/dev/null | wc -l)
    ETC_HOSTKEYS=$(ls /etc/dropbear/dropbear_*_host_key 2>/dev/null | wc -l)
    if [ "${SD_HOSTKEYS}" != "${ETC_HOSTKEYS}" ] 2>/dev/null || [ "${SD_HOSTKEYS}" = "0" ] 2>/dev/null
    then
        printf "*** Saving SSH host keys to sd card... "
        cp /etc/dropbear/dropbear_*_host_key "${SD_MOUNTDIR}/firmware/etc/dropbear/" 2>/dev/null
        ok_fail "$?"
    fi
}


case "$1" in
  start)
        [ ! -d /etc/dropbear ] && mkdir -p /etc/dropbear

        ## Recover previous files from sdcard
        recover_key

        ## Start the daemon detached from this session (nohup makes it ignore the
        ## SIGHUP an ssh-session close sends to its children). dropbear writes
        ## its own pidfile via -P, so stop/restart always target the live
        ## listener (start-stop-daemon --make-pidfile was writing stale pids).
        nohup "${DAEMON}" ${DAEMON_OPTS} </dev/null >>/var/log/dropbear.log 2>&1 &

        ## Save the key to the sdcard
        save_key
    ;;
  stop)
    stop_daemon
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  status)
    status_daemon
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit $?